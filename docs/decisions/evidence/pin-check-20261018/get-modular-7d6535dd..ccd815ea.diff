+const gc = (globalThis as { readonly gc?: () => void }).gc;
+const tick = (): Promise<void> => new Promise((resolve) => { setImmediate(resolve); });
+const settle = delivered; // the testing entry point: no tuned tick counts
+const collect = async (): Promise<void> => {
+  assert.ok(gc, "run with node --expose-gc");
+  for (let i = 0; i < 6; i += 1) { await tick(); gc(); }
+};
+const codeOf = (error: unknown): unknown => (error as { readonly code?: unknown } | null)?.code;
+const debtsOf = (report: CloseReport) =>
+  report.debts.map((debt) => ({ path: debt.path.join("/"), state: debt.state, code: debt.state === "failed" ? codeOf(debt.cause) : undefined }));
+
+type Settings = { readonly level: string; readonly region: string; readonly theme: string };
+type Gate = { readonly region: string; readonly signal: AbortSignal; readonly release: (value: string) => void };
+
+type Limits = { readonly maxSubscriptionsPerScope?: number; readonly maxSubscriptions?: number };
+function world<V extends object & Required<V> & FixedKeys<V>>(initial: V, limits: Limits = {}) {
+  const reports: ListenerError[] = [];
+  const host = createScope({ name: "host" });
+  const owner = host.resources.child({ name: "owner" });
+  const store = createStore<V>(initial, {
+    name: "settings", resources: owner.resources,
+    reportError: (report) => { reports.push(report); return undefined; },
+    ...limits,
+  });
+  const module = host.resources.child({ name: "module" });
+  return { host, owner, module, store, facet: store.readonly(), reports };
+}
+
+/** A catalog-style load on `region`. `stubborn` loaders ignore their signal until released. */
+function regionLoad(facet: ReturnType<typeof world<Settings>>["facet"], resources: Resources, stubborn: boolean) {
+  const runs: Gate[] = [];
+  const published: string[] = [];
+  facet.load(facet.read(["region"]), {
+    resources, name: "catalog",
+    loader: ({ values }, { signal }) => new Promise<string>((resolve, reject) => {
+      runs.push({ region: values.region, signal, release: resolve });
+      if (!stubborn) signal.addEventListener("abort", () => { reject(signal.reason); }, { once: true });
+    }),
+    onLoading: () => undefined,
+    onResult: (result) => { published.push(result); },
+    onError: (cause) => { published.push(`error:${String(cause)}`); },
+  });
+  return { runs, published };
+}

+// Variant B: resource, memory and scaling probes against @get-modular/resources built from get-modular origin/main
+// (runtime-b/node_modules/@get-modular/resources -> ../.gm-resources-main, commit in its SOURCE_COMMIT file).
+//   node --expose-gc runtime-b/probes.test.ts
+import assert from "node:assert/strict";
+import { createServer, request, type Server } from "node:http";
+import { describe, mock, test } from "node:test";
+import { createScope, scoped, type CloseReport, type ModuleContext, type Resources } from "@get-modular/resources";
+import { asyncDetection, createStore, delivered, liveSubscriptions, MAX_CASCADE_DEPTH, settled, stats, type ListenerError } from "./observation.ts";
+import { pendingWork } from "../runtime/core.ts";
+import type { FixedKeys } from "../b-snapshot/api.js";

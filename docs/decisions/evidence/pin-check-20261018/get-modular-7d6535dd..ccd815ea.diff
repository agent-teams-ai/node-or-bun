+import type { ModuleContext } from "@get-modular/resources";
+import { createStore } from "@get-modular/observation";
+import {
+  createNotifier, parseQuietHours, type NotificationStatus, type NotificationsDeps, type NotificationsProduct,
+} from "./i-errors.types.js";
+
+export async function createNotificationsModule(deps: NotificationsDeps, { resources }: ModuleContext): Promise<NotificationsProduct> {
+  const quiet = deps.settings.read(["quietHours"]);
+  const notifier = createNotifier(parseQuietHours(quiet.values.quietHours));
+  // An invalid value throws here: the settings store reports it with this subscription's name, and later revisions still arrive.
+  deps.settings.watch(quiet, {
+    resources,
+    name: "notifications/quiet-hours",
+    onChange: ({ values }) => {
+      notifier.setQuietHours(parseQuietHours(values.quietHours));
+    },
+  });
+  const status = createStore<NotificationStatus>({ muted: false }, {
+    name: "notifications-status",
+    resources,
+    reportError: deps.errors.report,
+  });
+  return {
+    instance: notifier,
+    capabilities: {
+      "acme/notifications": {
+        mute: (muted) => {
+          status.set({ muted });
+        },
+      },
+      "acme/notifications/status": status.readonly(),
+    },
+  };
+}
diff --git a/research/module-communication-2026-10/raw/api-design/runtime-b/env-probe.ts.txt b/research/module-communication-2026-10/raw/api-design/runtime-b/env-probe.ts.txt
new file mode 100644
index 0000000..60ad220
--- /dev/null
+++ b/research/module-communication-2026-10/raw/api-design/runtime-b/env-probe.ts.txt
@@ -0,0 +1,86 @@
+// L2 and L3: environments prepared BEFORE the package loads. Run as separate processes (load order matters):
+//   node runtime-b/env-probe.ts fake-before   a fake global setImmediate that never fires, installed before import
+//   node runtime-b/env-probe.ts fake-clock-before   frozen global performance and Date clocks, installed before import
+//   node runtime-b/env-probe.ts no-node       no global setImmediate and no process.getBuiltinModule (browser-like)
+import assert from "node:assert/strict";
+
+const mode = process.argv[2];
+const realTimeout = globalThis.setTimeout;
+const realClearTimeout = globalThis.clearTimeout;
+const pause = (ms: number): Promise<void> => new Promise((resolve) => { realTimeout(resolve, ms); });
+if (mode === "fake-before") {
+  (globalThis as { setImmediate: unknown }).setImmediate = (): undefined => undefined; // like a fake installed globally
+} else if (mode === "fake-clock-before") {
+  Object.defineProperty(globalThis, "performance", { value: { now: () => 0 }, configurable: true });
+  Date.now = () => 0;
+} else if (mode === "no-node") {
+  delete (globalThis as { setImmediate?: unknown }).setImmediate;
+  Object.defineProperty(process, "getBuiltinModule", { value: undefined, configurable: true });
+} else {
+  throw new Error("usage: node runtime-b/env-probe.ts fake-before|fake-clock-before|no-node");
+}
+
+const { createScope } = await import("@get-modular/resources");
+const observation = await import("./observation.ts"); // must not throw a ReferenceError
+const host = createScope({ name: "host" });
+const reports: unknown[] = [];
+const store = observation.createStore<{ readonly level: number; readonly other: number; readonly cursor: number }>({ level: 0, other: 0, cursor: 0 },
+  { name: "settings", resources: host.resources, reportError: (report) => { reports.push(report.cause); } });
+const facet = store.readonly();
+const module = host.resources.child({ name: "m" });
+const seen: number[] = [];
+facet.watch(facet.read(["level"]), { resources: module.resources, name: "m/level", onChange: ({ values }) => { seen.push(values.level); } });
+store.set({ level: 1 });
+await observation.delivered({ stores: [facet], timeoutMs: 2_000 }); // must not hang
+assert.deepEqual(seen, [1], "the delivery ran");
+if (mode === "no-node") {
+  assert.equal(observation.asyncDetection, false, "no AsyncLocalStorage without getBuiltinModule");
+  // Synchronous echo detection still works.
+  let calls = 0;
+  facet.watch(facet.read(["other"]), { resources: module.resources, name: "m/echo", onChange: ({ values }) => { calls += 1; if (calls < 100) store.set({ other: values.other + 1 }); } });
+  store.set({ other: 1 });
+  await pause(50);
+  assert.equal(calls, 1, "a synchronous echo is caught at the first round");
+  const thrown: unknown[] = [];
+  let loaders = 0;
+  facet.load(facet.read(["cursor"]), {
+    resources: module.resources, name: "m/loader-echo",
+    loader: async ({ values }) => {
+      loaders += 1;
+      // No user await precedes this write. The engine's own startup trampoline cannot remove its synchronous context.
+      if (loaders < 5) {
+        try { store.set({ cursor: values.cursor + 1 }); } catch (cause) { thrown.push(cause); }
+      }
+      return "loaded";
+    },
+    onLoading: () => undefined, onResult: () => undefined, onError: () => undefined,
+  });
+  await observation.settled({ stores: [facet], timeoutMs: 2_000 });
+  assert.equal(loaders, 1, "the synchronous loader echo is caught at the first run");
+  assert.equal(store.read(["cursor"]).values.cursor, 0);
+  assert.deepEqual(thrown.map((cause) => (cause as { readonly code?: unknown }).code), ["observation.delivery.echo"]);
+  assert.deepEqual(reports.map((cause) => (cause as { readonly code?: unknown }).code), ["observation.delivery.echo", "observation.delivery.echo"]);
+} else {
+  assert.equal(observation.asyncDetection, true);
+}
+if (mode === "fake-clock-before") {
+  let finish!: () => void;
+  facet.load(facet.read(["cursor"]), {
+    resources: module.resources, name: "m/blocked",
+    loader: () => new Promise<void>((resolve) => { finish = resolve; }),
+    onLoading: () => undefined, onResult: () => undefined, onError: () => undefined,
+  });
+  await observation.delivered({ stores: [facet] });
+  const waiting = observation.settled({ stores: [facet], timeoutMs: 20 }).then(() => "resolved", (cause: unknown) =>
+    (cause as { readonly code?: unknown }).code);
+  let watchdog!: ReturnType<typeof setTimeout>;
+  const outcome = await Promise.race([waiting, new Promise<string>((resolve) => {
+    watchdog = realTimeout(() => { resolve("real watchdog elapsed"); }, 500);
+  })]);
+  realClearTimeout(watchdog);
+  finish(); // also release the broken version so a failing deadline regression cannot hang its test process
+  await waiting;
+  assert.equal(outcome, "observation.testing.timeout", "the builtin real clock must expire the deadline before the watchdog");
+}
+await host.control.close();
+console.log(`${mode}: import ok; delivery ok; asyncDetection ${observation.asyncDetection}`);
diff --git a/research/module-communication-2026-10/raw/api-design/runtime-b/measure-watch-memory.ts.txt b/research/module-communication-2026-10/raw/api-design/runtime-b/measure-watch-memory.ts.txt
new file mode 100644
index 0000000..4f6da45
--- /dev/null
+++ b/research/module-communication-2026-10/raw/api-design/runtime-b/measure-watch-memory.ts.txt
@@ -0,0 +1,54 @@
+// N5 measurement (not a test): heap per live watch, and what a long-lived subscriber scope keeps per closed source.
+//   node --expose-gc runtime-b/measure-watch-memory.ts                                   (bound to resources.signal only)
+//   OBSERVATION_STUB_WATCH_SCOPE=child node --expose-gc runtime-b/measure-watch-memory.ts (a child scope per watch)
+//   OBSERVATION_STUB_WATCH_SCOPE=entry node --expose-gc runtime-b/measure-watch-memory.ts (one entry per watch)
+import { createScope } from "@get-modular/resources";
+import { createStore } from "./observation.ts";
+
+const gc = (globalThis as { readonly gc?: () => void }).gc;
+if (gc === undefined) throw new Error("run with --expose-gc");
+const tick = (): Promise<void> => new Promise((resolve) => { setImmediate(resolve); });
+const collect = async (): Promise<void> => { for (let i = 0; i < 6; i += 1) { await tick(); gc(); } };
+const heap = (): number => process.memoryUsage().heapUsed;
+const mode = { child: "child scope per watch", entry: "entry per watch" }[process.env.OBSERVATION_STUB_WATCH_SCOPE ?? ""] ?? "signal binding only";
+
+// 1. Live watches: 20 000 subscriptions of one store in one subscriber scope.
+{
+  const host = createScope({ name: "host" });
+  const store = createStore<{ readonly level: string }>({ level: "info" }, {
+    name: "settings", resources: host.resources, reportError: () => undefined, maxSubscriptionsPerScope: 50_000, maxSubscriptions: 50_000,
+  });
+  const facet = store.readonly();
+  const subscriber = host.resources.child({ name: "dashboard" });
+  const handler = (): undefined => undefined;
+  await collect();
+  const before = heap();
+  for (let i = 0; i < 20_000; i += 1) facet.watch(facet.read(["level"]), { resources: subscriber.resources, name: `w${i}`, onChange: handler });
+  await collect();
+  console.log(`${mode}: ${((heap() - before) / 20_000).toFixed(0)} bytes per live watch (20 000 live)`);
+  await subscriber.control.close();
+  await host.control.close();
+}
+
+// 2. Closed sources: 50 000 stores each followed by a long-lived scope and then closed first.
+{
+  const host = createScope({ name: "host" });
+  const dashboard = host.resources.child({ name: "dashboard" });
+  const round = async (n: number, offset: number): Promise<void> => {
+    for (let i = 0; i < n; i += 1) {
+      const owner = host.resources.child({ name: "session" });
+      const store = createStore<{ readonly status: string }>({ status: "open" }, { name: "session/status", resources: owner.resources, reportError: () => undefined });
+      const facet = store.readonly();
+      facet.watch(facet.read(["status"]), { resources: dashboard.resources, name: `dashboard/session-${offset + i}`, onChange: () => undefined });
+      await owner.control.close();
+    }
+  };
+  await round(1_000, 0);
+  await collect();
+  const before = heap();
+  await round(50_000, 1_000);
+  await collect();
+  console.log(`${mode}: ${((heap() - before) / 50_000).toFixed(0)} bytes kept per closed source while the subscriber scope stays open`);
+  await dashboard.control.close();
+  await host.control.close();
+}

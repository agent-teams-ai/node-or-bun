index 0000000..14acf9b
--- /dev/null
+++ b/tests/qualification/consumer-fixtures/recovery/src/effect.ts
@@ -0,0 +1,43 @@
+import { open } from "node:fs/promises";
+import { CANCELLED, errorCode, failure, object } from "./schema.js";
+
+const path = process.argv[2];
+const scope = process.argv[3];
+const id = process.argv[4];
+const payload = process.argv[5];
+if (path === undefined || scope === undefined || id === undefined || payload === undefined || process.send === undefined) {
+  throw failure("fixture.effect.arguments");
+}
+const file = await open(path, "wx+");
+let chosen = false;
+function send(value: object): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (process.send === undefined) { reject(failure("fixture.effect.disconnected")); return; }
+    process.send(value, cause => cause ? reject(cause) : resolve());
+  });
+}
+process.on("message", (message: unknown) => {
+  if (!object(message) || (message.type !== "complete" && message.type !== "stop") || chosen) return;
+  chosen = true;
+  const success = message.type === "complete";
+  void (async () => {
+    const value = success ? `${scope}:A:${payload}` : CANCELLED;
+    if (success) {
+      await file.appendFile(`${JSON.stringify({ scope, id, value })}\n`, "utf8");
+      await file.sync();
+    }
+    await file.close();
+    await send({ type: "result", value });
+    process.disconnect();
+  })().catch(async cause => {
+    await file.close().catch(() => {});
+    await send({ type: "fatal", code: errorCode(cause) }).catch(() => {});
+    if (process.connected) process.disconnect();
+    process.exitCode = 1;
+  });
+});
+// Handshake follows actual acquisition. A send callback is never counted as physical spawn or exit.
+await send({ type: "held", pid: process.pid });
+// One producer-side fault tests decoding before a worker has necessarily installed its result waiter.
+// The real child remains held with its file open until the supervisor's cooperative stop arrives.
+if (process.argv[6] === "invalid-result") await send({ type: "result", value: "recovery:A:world" });
diff --git a/tests/qualification/consumer-fixtures/recovery/src/operation-owner.ts b/tests/qualification/consumer-fixtures/recovery/src/operation-owner.ts
new file mode 100644
index 0000000..f2ae7ab
--- /dev/null
+++ b/tests/qualification/consumer-fixtures/recovery/src/operation-owner.ts
@@ -0,0 +1,141 @@
+import {
+  CANCELLED, caps, failure, freshToken, key, record, snapshot, submission,
+  type ChildWitness, type Identity, type Profile, type Snapshot, type StoredRecord, type Submission,
+} from "./schema.js";
+import { SnapshotStore, type Transition } from "./store.js";
+
+interface Controls {
+  readonly reserve?: (value: Submission) => Promise<void>;
+  readonly cancel?: (value: Identity) => void;
+  readonly freeze?: () => void;
+}
+
+// The sole transition queue is finite fixture policy. It never owns a child lifetime.
+export class OperationOwner {
+  private tail: Promise<void> = Promise.resolve();
+  private frozen = false;
+
+  private constructor(private readonly store: SnapshotStore, private current: Snapshot, private readonly controls: Controls) {}
+
+  static async open(store: SnapshotStore, selected: Profile, controls: Controls = {}): Promise<OperationOwner> {
+    const current = await store.read();
+    if (current.profile !== selected) throw failure("fixture.store.profile");
+    return new OperationOwner(store, current, controls);
+  }
+
+  status(): { readonly frozen: boolean; readonly snapshot: Snapshot } {
+    return { frozen: this.frozen, snapshot: snapshot(this.current) };
+  }
+  query(value: Identity): StoredRecord | undefined {
+    const found = this.current.records.find(candidate => key(candidate) === key(value));
+    return found === undefined ? undefined : record(found);
+  }
+
+  private serialize<T>(body: () => Promise<T>, ordinary = true): Promise<T> {
+    const command = this.tail.then(() => {
+      if (ordinary && this.frozen) throw failure("fixture.store.frozen");
+      return body();
+    });
+    this.tail = command.then(() => {}, () => {});
+    return command;
+  }
+  private freeze(): void {
+    this.frozen = true;
+    this.controls.freeze?.();
+  }
+  private async replace(records: readonly StoredRecord[], transition: Transition): Promise<void> {
+    const next = snapshot({ ...this.current, records });
+    try { await this.store.replace(next, transition); }
+    catch (cause) { this.freeze(); throw cause; }
+    this.current = next;
+  }
+  private change(previous: StoredRecord, next: StoredRecord, transition: Transition): Promise<void> {
+    return this.replace(this.current.records.map(candidate => key(candidate) === key(previous) ? next : candidate), transition);
+  }
+
+  submit(input: Submission): Promise<{ readonly created: boolean; readonly record: StoredRecord }> {
+    const value = submission(input);
+    return this.serialize(async () => {
+      const existing = this.query(value);
+      // Identity lookup and conflict detection precede both storage and live admission.
+      if (existing !== undefined) {
+        if (existing.fingerprint !== value.fingerprint || existing.input !== value.input) throw failure("fixture.operation.conflict");
+        return { created: false, record: existing };
+      }
+      if (this.current.records.length === caps.records) throw failure("fixture.store.record-cap");
+      await this.controls.reserve?.(value);
+      const accepted = record({ ...value, state: "pending", claim: null, cancel: false, cleanupDebt: false, child: null, result: null });
+      await this.replace([...this.current.records, accepted], "submit");
+      return { created: true, record: accepted };
+    });
+  }
+
+  claim(value: Identity): Promise<StoredRecord | undefined> {
+    return this.serialize(async () => {
+      const existing = this.query(value);
+      if (existing?.state !== "pending" || existing.cancel) return undefined;
+      const claimed = record({ ...existing, state: "claimed", claim: freshToken() });
+      await this.change(existing, claimed, "claim");
+      return claimed;
+    });
+  }
+
+  cancel(value: Identity): Promise<StoredRecord> {
+    // Revocation and participant stop must remain usable through a blocked or frozen store.
+    this.controls.cancel?.(value);
+    return this.serialize(async () => {
+      const existing = this.query(value);
+      if (existing === undefined) throw failure("fixture.operation.missing");
+      if (existing.state === "terminal") return existing;
+      const cancelled = record({ ...existing, state: "terminal", cancel: true, result: CANCELLED });
+      await this.change(existing, cancelled, "cancel");
+      return cancelled;
+    });
+  }
+
+  recordResult(value: Identity, observed: ChildWitness): Promise<StoredRecord> {
+    return this.serialize(async () => {
+      const existing = this.query(value);
+      if (existing === undefined) throw failure("fixture.operation.missing");
+      const chosen = existing.state === "terminal" ? existing.result : observed.result;
+      const next = record({ ...existing, child: observed.child, cleanupDebt: observed.cleanupDebt, result: chosen,
+        state: chosen === null ? existing.state : "terminal" });
+      await this.change(existing, next, "recordResult");
+      return next;
+    });
+  }
+
+  reconcile(observe: (value: Identity) => Promise<ChildWitness | undefined> = async () => undefined): Promise<Snapshot> {
+    return this.serialize(async () => {
+      let actual: Snapshot;
+      try {
+        actual = await this.store.read();
+        if (actual.profile !== this.current.profile) throw failure("fixture.store.profile");
+      } catch (cause) { this.freeze(); throw cause; }
+      this.current = actual;
+      try {
+        const records: StoredRecord[] = [];
+        for (const existing of actual.records) {
+          const observed = await observe(existing);
+          // An effect result precedes semantic terminal recording; custody alone cannot promote it.
+          // An unresolved claim never authorizes a retry.
+          records.push(record({ ...existing,
+            state: existing.state === "claimed" ? "quarantined" : existing.state,
+            child: observed?.child ?? existing.child, cleanupDebt: observed?.cleanupDebt ?? existing.cleanupDebt,
+          }));
+        }
+        if (JSON.stringify(records) !== JSON.stringify(actual.records)) await this.replace(records, "reconcile");
+        this.frozen = false;
+        return snapshot(this.current);
+      } catch (cause) { this.freeze(); throw cause; }
+    }, false);
+  }
+}
+
+// Deliberately has no submit/claim/launch surface and acquires no writer grant.
+export async function readReconcileOnly(store: SnapshotStore): Promise<Snapshot> {
+  const actual = await store.read();
+  return snapshot({ ...actual, records: actual.records.map(value => record({ ...value,
+    state: value.state === "claimed" ? "quarantined" : value.state,
+  })) });
+}
diff --git a/tests/qualification/consumer-fixtures/recovery/src/schema.ts b/tests/qualification/consumer-fixtures/recovery/src/schema.ts
new file mode 100644
index 0000000..a587bb1
--- /dev/null
+++ b/tests/qualification/consumer-fixtures/recovery/src/schema.ts
@@ -0,0 +1,143 @@
+import { createHash, randomBytes } from "node:crypto";
+
+export type Profile = "record-only" | "restart-pending";
+export const SUCCESS = "recovery:A:hello";
+export const CANCELLED = "fixture.operation.cancelled";
+export const BOUNDARY_RESULT = `bound:${'"'.repeat(92)}`;
+export type FixtureResult = typeof SUCCESS | typeof CANCELLED | typeof BOUNDARY_RESULT;
+export const caps = { records: 32, record: 1792, envelope: 4096, canonical: 64 * 1024 } as const;
+// The complete catalog is fixed and checked before an owner can admit any work.
+for (const value of [SUCCESS, CANCELLED, BOUNDARY_RESULT]) {
+  if (bytes(value) > 192) throw failure("fixture.store.result-catalog");
+}
+
+export interface Identity { readonly scope: string; readonly id: string }
+export interface Submission extends Identity { readonly input: string; readonly fingerprint: string }
+export interface StoredChild {
+  readonly pid: number;
+  readonly started: boolean;
+  readonly exited: boolean;
+  readonly code: number | null;
+  readonly signal: "SIGTERM" | "SIGKILL" | null;
+}
+export interface StoredRecord extends Submission {
+  readonly state: "pending" | "claimed" | "terminal" | "quarantined";
+  readonly claim: string | null;
+  readonly cancel: boolean;
+  readonly cleanupDebt: boolean;
+  readonly child: StoredChild | null;
+  readonly result: FixtureResult | null;
+}
+export interface Snapshot {
+  readonly format: 1;
+  readonly profile: Profile;
+  readonly generation: string;
+  readonly records: readonly StoredRecord[];
+}
+export interface ChildWitness {
+  readonly child: StoredChild;
+  readonly cleanupDebt: boolean;
+  readonly result: FixtureResult | null;
+}
+
+export function failure(code: string): Error & { readonly code: string } {
+  return Object.assign(new Error(code), { code });
+}
+export function errorCode(cause: unknown): string {
+  return typeof cause === "object" && cause !== null && "code" in cause && typeof cause.code === "string"
+    ? cause.code : "fixture.unexpected";
+}
+export function object(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+function closed(value: unknown, keys: readonly string[]): asserts value is Record<string, unknown> {
+  if (!object(value) || Object.keys(value).length !== keys.length || keys.some(key => !Object.hasOwn(value, key))) {
+    throw failure("fixture.store.schema");
+  }
+}
+export function bytes(value: unknown): number {
+  const encoded = JSON.stringify(value);
+  if (encoded === undefined) throw failure("fixture.store.schema");
+  return Buffer.byteLength(encoded, "utf8");
+}
+function boundedString(value: unknown, limit: number): string {
+  if (typeof value !== "string" || bytes(value) > limit) throw failure("fixture.store.schema");
+  return value;
+}
+export function token(value: unknown): string {
+  if (typeof value !== "string" || !/^[0-9a-f]{32}$/.test(value)) throw failure("fixture.store.schema");
+  return value;
+}
+export function freshToken(): string { return randomBytes(16).toString("hex"); }
+export function profile(value: unknown): Profile {
+  if (value !== "record-only" && value !== "restart-pending") throw failure("fixture.store.schema");
+  return value;
+}
+export function identity(value: unknown): Identity {
+  closed(value, ["scope", "id"]);
+  return { scope: boundedString(value.scope, 64), id: boundedString(value.id, 64) };
+}
+export function submission(value: unknown): Submission {
+  closed(value, ["scope", "id", "input", "fingerprint"]);
+  return {
+    scope: boundedString(value.scope, 64), id: boundedString(value.id, 64),
+    input: boundedString(value.input, 896), fingerprint: boundedString(value.fingerprint, 128),
+  };
+}
+export function makeSubmission(id = "operation", input = " hello ", scope = "recovery"): Submission {
+  return submission({ scope, id, input, fingerprint: createHash("sha256").update(input).digest("hex") });
+}
+// Live execution has one successful result; the wider storage schema also serves capacity evidence.
+export function requireLiveResult(scope: string, normalizedInput: string): void {
+  if (scope !== "recovery" || normalizedInput !== "hello") throw failure("fixture.operation.unsupported-input");
+}
+export function key(value: Identity): string { return JSON.stringify([value.scope, value.id]); }
+export function child(value: unknown): StoredChild {
+  closed(value, ["pid", "started", "exited", "code", "signal"]);
+  if (typeof value.pid !== "number" || !Number.isSafeInteger(value.pid) || value.pid < 1 ||
+    typeof value.started !== "boolean" || typeof value.exited !== "boolean" ||
+    !(value.code === null || typeof value.code === "number" && Number.isInteger(value.code) &&
+      value.code >= -2147483648 && value.code <= 2147483647) ||
+    !(value.signal === null || value.signal === "SIGTERM" || value.signal === "SIGKILL")) {
+    throw failure("fixture.store.schema");
+  }
+  return { pid: value.pid, started: value.started, exited: value.exited, code: value.code, signal: value.signal };
+}
+export function result(value: unknown): FixtureResult {
+  if ((value !== SUCCESS && value !== CANCELLED && value !== BOUNDARY_RESULT) || bytes(value) > 192) {
+    throw failure("fixture.store.schema");
+  }
+  return value;
+}
+export function record(value: unknown): StoredRecord {
+  closed(value, ["scope", "id", "input", "fingerprint", "state", "claim", "cancel", "cleanupDebt", "child", "result"]);
+  if (value.state !== "pending" && value.state !== "claimed" && value.state !== "terminal" && value.state !== "quarantined" ||
+    typeof value.cancel !== "boolean" || typeof value.cleanupDebt !== "boolean") throw failure("fixture.store.schema");
+  const reconstructed: StoredRecord = {
+    scope: boundedString(value.scope, 64), id: boundedString(value.id, 64),
+    input: boundedString(value.input, 896), fingerprint: boundedString(value.fingerprint, 128), state: value.state,
+    claim: value.claim === null ? null : token(value.claim), cancel: value.cancel, cleanupDebt: value.cleanupDebt,
+    child: value.child === null ? null : child(value.child), result: value.result === null ? null : result(value.result),
+  };
+  if (bytes(reconstructed) > caps.record) throw failure("fixture.store.record-bytes");
+  return reconstructed;
+}
+export function snapshot(value: unknown): Snapshot {
+  closed(value, ["format", "profile", "generation", "records"]);
+  if (value.format !== 1 || !Array.isArray(value.records)) throw failure("fixture.store.schema");
+  if (value.records.length > caps.records) throw failure("fixture.store.record-cap");
+  const records = value.records.map(record);
+  if (new Set(records.map(key)).size !== records.length) throw failure("fixture.store.schema");
+  const reconstructed: Snapshot = { format: 1, profile: profile(value.profile), generation: token(value.generation), records };
+  if (bytes({ ...reconstructed, records: [] }) + Math.max(0, records.length - 1) > caps.envelope ||
+    bytes(reconstructed) > caps.canonical) throw failure("fixture.store.canonical-bytes");
+  return reconstructed;
+}
+export function emptySnapshot(selected: Profile): Snapshot {
+  return snapshot({ format: 1, profile: selected, generation: freshToken(), records: [] });
+}
+export function witness(value: unknown): ChildWitness {
+  closed(value, ["child", "cleanupDebt", "result"]);
+  if (typeof value.cleanupDebt !== "boolean") throw failure("fixture.ipc.invalid");
+  return { child: child(value.child), cleanupDebt: value.cleanupDebt, result: value.result === null ? null : result(value.result) };
+}
diff --git a/tests/qualification/consumer-fixtures/recovery/src/store.ts b/tests/qualification/consumer-fixtures/recovery/src/store.ts
new file mode 100644
index 0000000..0970c8a
--- /dev/null
+++ b/tests/qualification/consumer-fixtures/recovery/src/store.ts
@@ -0,0 +1,57 @@
+import { open, readFile, rename, type FileHandle } from "node:fs/promises";
+import { join } from "node:path";
+import { bytes, caps, failure, freshToken, snapshot, type Snapshot } from "./schema.js";
+
+export type StoreStage = "write" | "sync" | "close" | "rename" | "after-rename";
+export type Transition = "initialize" | "submit" | "claim" | "cancel" | "recordResult" | "reconcile";
+export type StoreSeam = (stage: StoreStage, transition: Transition) => void | Promise<void>;
+
+export class SnapshotStore implements AsyncDisposable {
+  readonly canonical: string;
+  private readonly handles = new Set<FileHandle>();
+
+  constructor(readonly directory: string, private readonly seam: StoreSeam = () => {}) {
+    this.canonical = join(directory, "snapshot.json");
+  }
+
+  async read(): Promise<Snapshot> {
+    // A missing expected canonical file is an error; temp files have no authority.
+    const contents = await readFile(this.canonical);
+    if (contents.byteLength > caps.canonical) throw failure("fixture.store.canonical-bytes");
+    const decoded: unknown = JSON.parse(contents.toString("utf8"));
+    return snapshot(decoded);
+  }
+
+  async replace(next: Snapshot, transition: Transition): Promise<void> {
+    const canonical = snapshot(next);
+    if (bytes(canonical) > caps.canonical) throw failure("fixture.store.canonical-bytes");
+    const temporary = join(this.directory, `snapshot-${freshToken()}.tmp`);
+    const handle = await open(temporary, "wx");
+    this.handles.add(handle);
+    try {

@@ -0,0 +1,12 @@
+// Wrong on purpose: acquires outside setup and registers afterwards with use(); if the scope started closing during
+// the await, use() refuses the log and it is never closed.
+import type { ModuleContext } from "@get-modular/resources";
+import { openAuditLog, type AuditDeps, type AuditProduct } from "./e-async-factory.types.js";
+
+export async function createAuditModule(deps: AuditDeps, { signal, resources }: ModuleContext): Promise<AuditProduct> {
+  const retention = deps.settings.read(["retentionDays"]);
+  const log = await openAuditLog(retention.values.retentionDays, { signal });
+  resources.use({ [Symbol.asyncDispose]: () => log.close() }, "audit/log");
+  deps.settings.watch(retention, { resources, name: "audit/retention", onChange: ({ values }) => { log.setRetention(values.retentionDays); } });
+  return { instance: log, capabilities: { "acme/audit": { record: (entry) => { log.append(entry); return undefined; } } } };
+}

+export async function createAuditModule(deps: AuditDeps, { resources }: ModuleContext): Promise<AuditProduct> {
+  // Read before the await: watch delivers any commit made while the log was opening.
+  const retention = deps.settings.read(["retentionDays"]);
+  const log = await openAuditLog(retention.values.retentionDays);
+  deps.settings.watch(retention, {
+    resources,
+    name: "audit/retention",
+    onChange: ({ values }) => {
+      log.setRetention(values.retentionDays);
+    },
+  });
+  return {
+    instance: log,
+    capabilities: {
+      "acme/audit": {
+        record: (entry): undefined => {
+          log.append(entry);
+          return undefined;
+        },
+      },
+    },
+  };

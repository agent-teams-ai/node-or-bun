+   * callback starts a cascade step; more than 64 steps in a row throw `observation.delivery.cascade`.
+   */
+  readonly set: <const K extends Key<V>>(patch: { readonly [P in K]: Frozen<V[P]> }) => number;
+  /** The facet to hand to other modules. The same frozen object on every call. */
+  readonly readonly: () => ReadonlyStore<V>;
+  /**
+   * Closes the store. Every live subscription is detached and released on the subscriber's side (nothing of it is
+   * retained), each gets one report `observation.source.closed` to `reportError`, and running loads are aborted.
+   * Then `read`, `set`, `watch` and `load` throw `observation.store.closed`. Idempotent and synchronous. Also runs
+   * when the owner's `resources` releases the entry `store:<name>`.
+   */
+  readonly close: () => undefined;
+};
+
+/**
+ * One failed callback of one subscription, as the store reports it to its owner's `reportError`.
+ * Owner side only: the owner wires `reportError` to the Host's error port. Only the store creates these reports,
+ * so a subscriber can never fake one: a subscriber lets its handler throw and the store reports the failure.
+ */
+export type ListenerError = {
+  /** The name of the source (the store) whose subscriber failed. */
+  readonly source: string;
+  /** The `name` the subscriber gave to `watch` or `load`. */
+  readonly subscription: string;
+  /**
+   * The path of the subscriber's scope, for example `["host", "attempt", "acme/catalog"]`. Present only when the
+   * resources package provides `Resources.path` (planned additive in @get-modular/resources 0.2).
+   */
+  readonly path?: readonly string[];
+  /** The revision that was being delivered. */
+  readonly revision: number;
+  /** What the handler threw, unchanged; or an ObservationError for `observation.callback.returned-value`, `observation.source.closed`, `observation.delivery.cascade`. */
+  readonly cause: unknown;
+  /** Type-only brand: there is no such property at run time. */
+  readonly [listenerErrorBrand]: true;
+};
+
+export type StoreOptions = {
+  /** Non-empty. Names the store in reports (`ListenerError.source`) and debt paths. */
+  readonly name: string;
+  /** The owner's scope. The store closes when this scope releases its entry `store:<name>` (LIFO order). */
+  readonly resources: Resources;
+  /**
+   * Receives every failure of a subscriber callback (a handler that throws or returns a value) and every
+   * `observation.source.closed`. Wire it to the Host's error port, for example `deps.errors.report`. Must be
+   * synchronous and must not throw.
+   */
+  readonly reportError: (report: ListenerError) => undefined;
+  /** Live subscriptions per subscriber scope (one `resources`) on this store. Default 64; one more throws `observation.subscriptions.limit`. */
+  readonly maxSubscriptionsPerScope?: number;
+  /** Live subscriptions on this store in total, a safety net set by the owner. Default 8192; one more throws `observation.subscriptions.limit`. */
+  readonly maxSubscriptions?: number;
+};
+
+/** Creates a store with one writer. `V` must declare every key (no `?:`, no index signature). */
+export declare function createStore<V extends object & Required<V> & FixedKeys<V>>(initial: V, options: StoreOptions): Store<V>;
+
+/**
+ * Codes of `ObservationError`. Thrown: `argument.invalid`, `keys.empty`, `keys.unknown`, `values.not-plain`,
+ * `store.closed`, `snapshot.foreign`, `subscription.duplicate-name`, `subscriptions.limit`, `delivery.cascade`.
+ * Reported to `reportError` (as `ListenerError.cause`): `callback.returned-value`, `source.closed`, and
+ * `delivery.cascade` when a handler let it propagate. A close debt: `load.still-running`.
+ */
+export type ObservationErrorCode =
+  | "observation.argument.invalid"
+  | "observation.keys.empty"
+  | "observation.keys.unknown"
+  | "observation.values.not-plain"
+  | "observation.store.closed"
+  | "observation.snapshot.foreign"
+  | "observation.subscription.duplicate-name"
+  | "observation.subscriptions.limit"
+  | "observation.delivery.cascade"
+  | "observation.callback.returned-value"
+  | "observation.source.closed"
+  | "observation.load.still-running";
+
+/** Compare `code`, never the class or the message. */
+export declare class ObservationError extends Error {
+  readonly code: ObservationErrorCode;
+}

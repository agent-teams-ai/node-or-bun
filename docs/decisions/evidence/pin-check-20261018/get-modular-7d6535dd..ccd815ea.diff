+    assert.deepEqual(unchanged.output, cold.output);
+    const leaf = await applyLeafEdit(directory, size);
+    report.edits = { leaf };
+    await saveReport();
+    await compile("leaf-edit");
+    report.leaf = await verifyEdit("leaf");
+    await restoreEdit(directory, leaf);

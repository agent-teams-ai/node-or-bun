@@ -0,0 +1,36 @@
+// Runs the behaviour scenario of one task against the fixed runtime stub of one variant.
+//   node tools/run-scenario.mjs <variant> <task> <solution.ts>
+// The solution's "@get-modular/observation" import is pointed at runtime/<variant>.ts, and "./<task>.types.js"
+// resolves to the instrumented fakes in tasks/fakes/. Nothing else in the solution is changed.
+import { spawnSync } from "node:child_process";
+import { copyFileSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync, existsSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const [variant, task, solution] = process.argv.slice(2);
+const adapter = join(root, "runtime", `${variant}.ts`);
+const scenario = join(root, "tasks", "scenarios", `${task}.scenario.mjs`);
+if (!variant || !task || !solution || !existsSync(adapter) || !existsSync(scenario)) {
+  console.error("usage: node tools/run-scenario.mjs <a-keys|b-snapshot> <task> <solution.ts>");
+  process.exit(2);
+}
+mkdirSync(join(root, ".build"), { recursive: true });
+const dir = mkdtempSync(join(root, ".build", `scenario-${variant}-${task}-`));
+const source = readFileSync(solution, "utf8").replace(/(["'])@get-modular\/observation\1/g, JSON.stringify(adapter));
+writeFileSync(join(dir, `${task}.ts`), source);
+copyFileSync(join(root, "tasks", "fakes", `${task}.types.js`), join(dir, `${task}.types.js`));
+copyFileSync(join(root, "tasks", "scenarios", "harness.mjs"), join(dir, "harness.mjs"));
+copyFileSync(scenario, join(dir, `${task}.scenario.mjs`));
+const result = spawnSync(process.execPath, ["--expose-gc", join(dir, `${task}.scenario.mjs`), adapter, join(root, "runtime", "core.ts")],
+  { encoding: "utf8", timeout: 30_000 });
+process.stdout.write(result.stdout ?? "");
+if (result.error?.code === "ETIMEDOUT" || result.signal === "SIGTERM") {
+  console.log(`  BEHAVIOUR ${task}: the scenario did not finish within 30 s (a factory or close that never settles)`);
+  process.exit(1);
+}
+if (result.status !== 0 && !(result.stdout ?? "").includes("behaviour failure")) {
+  console.log(`  BEHAVIOUR ${task}: the solution could not be loaded or crashed the scenario`);
+  process.stdout.write((result.stderr ?? "").split("\n").slice(0, 8).map((line) => `    ${line}`).join("\n") + "\n");
+}
+process.exit(result.status === 0 ? 0 : 1);
diff --git a/research/module-communication-2026-10/raw/api-design/tools/static-rules.mjs.txt b/research/module-communication-2026-10/raw/api-design/tools/static-rules.mjs.txt
new file mode 100644
index 0000000..24b88f4
--- /dev/null
+++ b/research/module-communication-2026-10/raw/api-design/tools/static-rules.mjs.txt
@@ -0,0 +1,46 @@
+// Static rules for one task solution: no escape hatches, and the task uses the intended part of the API.
+//   node tools/static-rules.mjs <variant> <task> <file.ts>
+import { readFileSync } from "node:fs";
+
+const [variant, task, file] = process.argv.slice(2);
+const source = readFileSync(file, "utf8");
+// Rough comment stripping is enough for these patterns; string literals in solutions are short.
+const code = source.replace(/\/\*[\s\S]*?\*\//g, "").replace(/(^|[^:])\/\/.*$/gm, "$1");
+
+const rules = [
+  { test: /@ts-(ignore|expect-error|nocheck)/.test(source), message: "uses a @ts- directive" },
+  { test: /(eslint|oxlint)-disable/.test(source), message: "disables a lint rule" },
+  { test: /(:|<|\bas)\s*any\b|\bany\[\]/.test(code), message: "uses any" },
+  { test: /\bas\s+(?!const\b)[A-Za-z_{[(]/.test(code), message: "uses a type assertion (as)" },
+];
+const uses = (member) => new RegExp(`\\.${member}\\s*\\(`).test(code);
+const required = {
+  "a-logger": ["watch"],
+  "b-catalog": ["load"],
+  "c-pricing-context": ["watch", "readonly"],
+  "d-greeter": ["read"],
+  "e-async-factory": ["read", "watch"],
+  "e-sessions": ["watch", "child"],
+  "f-watch-and-load": ["watch", "load"],
+  "g-hierarchy": ["watch", "readonly"],
+  "h-requests": ["read", "watch"],
+  "i-errors": ["watch", "readonly"],
+}[task] ?? [];
+const forbidden = { "d-greeter": ["watch", "load"] }[task] ?? [];
+for (const member of required) rules.push({ test: !uses(member), message: `does not call .${member}(...)` });
+for (const member of forbidden) rules.push({ test: uses(member), message: `calls .${member}(...), which this task must not use` });
+const ownsStore = ["c-pricing-context", "g-hierarchy", "i-errors"];
+if (ownsStore.includes(task)) rules.push({ test: !/\bcreateStore\s*[<(]/.test(code), message: "does not call createStore" });
+// The first value goes through load as well; a second fetch outside the loader races with it.
+const fetchers = { "b-catalog": "fetchModels", "f-watch-and-load": "fetchHolidays" };
+const fetcher = fetchers[task];
+if (fetcher !== undefined) {
+  rules.push({ test: (code.match(new RegExp(`\\b${fetcher}\\s*\\(`, "g")) ?? []).length > 1, message: `calls ${fetcher} outside the loader` });
+}
+// A session's subscription lives in a scope that the session closes.
+if (task === "e-sessions") rules.push({ test: !/\.control\.close\s*\(/.test(code), message: "does not close the session scope" });
+void variant; // reserved for variant-specific rules
+
+const broken = rules.filter((rule) => rule.test).map((rule) => rule.message);
+for (const message of broken) console.log(`  RULE ${task}: ${message}`);
+process.exit(broken.length > 0 ? 1 : 0);
diff --git a/research/module-communication-2026-10/raw/api-design/tools/tsc-both.mjs.txt b/research/module-communication-2026-10/raw/api-design/tools/tsc-both.mjs.txt
new file mode 100644
index 0000000..bcef234
--- /dev/null
+++ b/research/module-communication-2026-10/raw/api-design/tools/tsc-both.mjs.txt
@@ -0,0 +1,115 @@
+// Compiles TypeScript files against one API variant on tsc7 (TS 7) and TypeScript 5.8.3.
+//
+//   node tools/tsc-both.mjs <variant> <file.ts...>            plain compile, exit 1 on any error
+//   node tools/tsc-both.mjs --expect <variant> <file.ts...>   also proves every `@ts-expect-error <label>`
+//                                                            fails for its own line, and prints the codes
+//
+// The files are copied into a fresh directory under .build/, so their location does not matter.
+import { execFileSync } from "node:child_process";
+import { cpSync, mkdtempSync, mkdirSync, readFileSync, writeFileSync, existsSync } from "node:fs";
+import { basename, dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const compilers = [
+  { id: "tsc7", bin: process.env.TSC7 ?? "tsc7" },
+  { id: "ts5.8.3", bin: join(root, ".toolchain/node_modules/.bin/tsc") },
+];
+
+const args = process.argv.slice(2);
+const flag = (name) => { const at = args.indexOf(name); if (at >= 0) args.splice(at, 1); return at >= 0; };
+const expect = flag("--expect");
+// Consumers whose tsconfig lacks exactOptionalPropertyTypes.
+const looseOptional = flag("--loose-optional");
+// Assembly and resources from get-modular origin/main sources (.gm-main/SOURCE_COMMIT), core from the 0.4.0 package.
+const gmMain = flag("--gm-main");
+const [variant, ...files] = args;
+if (!variant || files.length === 0 || !existsSync(join(root, variant, "api.d.ts"))) {
+  console.error("usage: node tools/tsc-both.mjs [--expect] [--loose-optional] [--gm-main] <variant> <file.ts...>");
+  process.exit(2);
+}
+
+function buildDir(tag) {
+  mkdirSync(join(root, ".build"), { recursive: true });
+  const dir = mkdtempSync(join(root, ".build", `${variant.replaceAll("/", "_")}-${tag}-`));
+  writeFileSync(join(dir, "tsconfig.json"), JSON.stringify({
+    extends: join(root, "tsconfig.base.json"),
+    compilerOptions: {
+      ...(looseOptional ? { exactOptionalPropertyTypes: false } : {}),
+      ...(gmMain ? { lib: ["ESNext", "ESNext.Disposable", "DOM"] } : {}),
+      paths: {
+        "@get-modular/observation": [join(root, variant, "api.d.ts")],
+        "@get-modular/observation/testing": [join(root, variant, "testing.d.ts")],
+        "@get-modular/resources": [gmMain ? join(root, ".gm-main/packages/resources/src/index.ts") : join(root, ".toolchain/node_modules/@get-modular/resources/dist/index.d.ts")],
+        "@get-modular/assembly": [gmMain ? join(root, ".gm-main/packages/assembly/src/index.ts") : join(root, ".toolchain/node_modules/@get-modular/assembly/dist/index.d.ts")],
+        "@get-modular/core": [join(root, ".toolchain/node_modules/@get-modular/core/dist/index.d.ts")],
+      },
+    },
+    include: ["*.ts"],
+  }, null, 2));
+  return dir;
+}
+
+function compile(bin, dir) {
+  try {
+    execFileSync(bin, ["-p", dir, "--pretty", "false"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
+    return [];
+  } catch (error) {
+    const output = `${error.stdout ?? ""}${error.stderr ?? ""}`;
+    const lines = output.split("\n");
+    const errors = [];
+    for (const line of lines) {
+      const match = /^(.+?)\((\d+),(\d+)\): error (TS\d+): (.*)$/.exec(line);
+      if (match) errors.push({ file: basename(match[1]), line: Number(match[2]), code: match[4], message: match[5] });
+      else if (/error TS\d+/.test(line)) errors.push({ file: "?", line: 0, code: "?", message: line });
+    }
+    if (errors.length === 0) errors.push({ file: "?", line: 0, code: "?", message: output.trim() || String(error) });
+    return errors;
+  }
+}
+
+let failed = false;
+const plain = buildDir("plain");
+for (const file of files) cpSync(file, join(plain, basename(file)));
+for (const { id, bin } of compilers) {
+  const errors = compile(bin, plain);
+  console.log(`[${variant}] ${id}: ${errors.length === 0 ? "OK (0 errors)" : `${errors.length} error(s)`}`);
+  for (const e of errors) console.log(`  ${e.file}:${e.line} ${e.code} ${e.message}`);
+  if (errors.length > 0) failed = true;
+}
+
+if (expect) {
+  // Replace each directive with a plain comment of the same line count, then compile and attribute errors.
+  const stripped = buildDir("stripped");
+  const directives = [];
+  for (const file of files) {
+    const lines = readFileSync(file, "utf8").split("\n");
+    lines.forEach((text, index) => {
+      const match = /^(\s*)\/\/ @ts-expect-error\s*(.*)$/.exec(text);
+      if (match) {
+        directives.push({ file: basename(file), line: index + 2, label: match[2] });
+        lines[index] = `${match[1]}// (expected error) ${match[2]}`;
+      }
+    });
+    writeFileSync(join(stripped, basename(file)), lines.join("\n"));
+  }
+  const table = directives.map((d) => ({ ...d, codes: {} }));
+  for (const { id, bin } of compilers) {
+    const errors = compile(bin, stripped);
+    for (const row of table) {
+      const own = errors.filter((e) => e.file === row.file && e.line === row.line);
+      row.codes[id] = own.length === 0 ? "NONE" : [...new Set(own.map((e) => e.code))].join(",");
+      if (own.length === 0) failed = true;
+    }
+    const stray = errors.filter((e) => !table.some((row) => row.file === e.file && row.line === e.line));
+    for (const e of stray) {
+      console.log(`  STRAY ${id} ${e.file}:${e.line} ${e.code} ${e.message}`);
+      failed = true;
+    }
+  }
+  console.log(`\n| File:line | Expectation | tsc7 | TS 5.8.3 |\n| --- | --- | --- | --- |`);
+  for (const row of table) {
+    console.log(`| ${row.file}:${row.line} | ${row.label} | ${row.codes.tsc7} | ${row.codes["ts5.8.3"]} |`);
+  }
+}
+process.exit(failed ? 1 : 0);
diff --git a/research/module-communication-2026-10/raw/api-design/tsconfig.base.json.txt b/research/module-communication-2026-10/raw/api-design/tsconfig.base.json.txt

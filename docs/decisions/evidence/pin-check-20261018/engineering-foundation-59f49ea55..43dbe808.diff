diff --git a/tests/findings-baseline-capability.test.mjs b/tests/findings-baseline-capability.test.mjs
new file mode 100644
index 000000000..0b046c4da
--- /dev/null
+++ b/tests/findings-baseline-capability.test.mjs
@@ -0,0 +1,133 @@
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { promisify } from "node:util";
+import test from "node:test";
+import { copyPinnedToolchain } from "./features/quality-coverage/copied-toolchain.mjs";
+
+const cli = join(dirname(dirname(fileURLToPath(import.meta.url))), "packages/engineering-foundation/dist/cli.js");
+const baselinePath = "architecture/findings-baseline.jsonl";
+const lines = (count) => `${Array.from({ length: count }, (_, index) => `export const value${index} = ${index};`).join("\n")}\n`;
+const methodStyle = "export interface Shape {\n  area(): number;\n}\n";
+
+async function fixture(t) {
+  const root = await mkdtemp(join(tmpdir(), "ef-findings-baseline-TEST-"));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  const put = async (path, value) => {
+    await mkdir(dirname(join(root, path)), { recursive: true });
+    await writeFile(join(root, path), typeof value === "string" ? value : JSON.stringify(value));
+  };
+  const pins = await copyPinnedToolchain(root);
+  await put("package.json", { name: "findings-baseline-test", private: true, type: "module", devDependencies: pins });
+  await put("pnpm-workspace.yaml", "packages: []\n");
+  await put("lint.json", { rules: { "max-lines": ["error", { max: 3 }], "typescript/method-signature-style": "error" } });
+  await put("findings.yaml", { schemaVersion: 1, baselinePath, oxlint: { configPath: "lint.json", roots: ["src"], measuredRules: ["eslint/max-lines"] } });
+  await put("src/big.ts", lines(6));
+  await put("src/shape.ts", methodStyle);
+  await put("src/small.ts", lines(2));
+  const run = async (...args) => {
+    try {
+      const { stdout } = await promisify(execFile)(process.execPath, [cli, ...args, "--config", "findings.yaml", "--consumer", root, "--format", "json"], { cwd: root });
+      return { code: 0, output: JSON.parse(stdout) };
+    } catch (error) { return { code: error.code, output: JSON.parse(error.stdout) }; }
+  };
+  const diagnostics = async () => {
+    const { code, output } = await run("baseline", "check");
+    return { code, outcome: output.outcome, rules: output.capabilities[0].diagnostics.map(({ ruleId, location }) => `${ruleId.split(".").pop()} ${location.path}`).toSorted() };
+  };
+  return { root, put, run, diagnostics, baseline: () => readFile(join(root, baselinePath), "utf8") };
+}
+
+test("the findings baseline shrinks: init, check, new, worse, stale, prune and a refused second init", async (t) => {
+  const { put, run, diagnostics, baseline } = await fixture(t);
+  assert.equal((await diagnostics()).outcome, "invalid-input", "a missing baseline is an input error, not a pass");
+  const created = await run("baseline", "init");
+  assert.equal(created.code, 0, JSON.stringify(created));
+  assert.equal(created.output.baseline.entries, 2);
+  assert.equal(await baseline(), [
+    '{"findingsBaseline":1}',
+    '{"path":"src/big.ts","rule":"oxlint/eslint/max-lines","count":1,"max":6}',
+    '{"path":"src/shape.ts","rule":"oxlint/typescript/method-signature-style","count":1}', ""
+  ].join("\n"));
+  assert.deepEqual(await diagnostics(), { code: 0, outcome: "passed", rules: [] });
+  const refused = await run("baseline", "init");
+  assert.notEqual(refused.code, 0);
+  assert.match(JSON.stringify(refused.output), /FINDINGS_BASELINE_EXISTS/u);
+
+  await put("src/big.ts", lines(7));
+  assert.deepEqual((await diagnostics()).rules, ["worse-finding src/big.ts"]);
+  await put("src/new.ts", lines(5));
+  assert.deepEqual((await diagnostics()).rules, ["new-finding src/new.ts", "worse-finding src/big.ts"]);
+  const pruneNew = await run("baseline", "prune");
+  assert.equal(pruneNew.code, 1, "prune cannot accept new or worse findings");
+  assert.deepEqual(pruneNew.output.baseline.remaining.map(({ kind }) => kind), ["worse", "new"]);
+
+  await put("src/new.ts", lines(1));
+  await put("src/big.ts", lines(4));
+  assert.deepEqual((await diagnostics()).rules, ["stale-entry src/big.ts"]);
+  const pruned = await run("baseline", "prune");
+  assert.equal(pruned.code, 0, JSON.stringify(pruned));
+  assert.equal(pruned.output.baseline.lowered, 1);
+  assert.match(await baseline(), /"max":4/u);
+  assert.deepEqual(await diagnostics(), { code: 0, outcome: "passed", rules: [] });
+
+  await put("src/shape.ts", "export interface Shape {\n  area: () => number;\n}\n");
+  assert.deepEqual((await diagnostics()).rules, ["stale-entry src/shape.ts"]);
+  assert.equal((await run("baseline", "prune")).output.baseline.removed, 1);
+  assert.doesNotMatch(await baseline(), /shape/u);
+  assert.deepEqual(await diagnostics(), { code: 0, outcome: "passed", rules: [] });
+});
+
+test("a hand-edited baseline that is not canonical is rejected", async (t) => {
+  const { put, run, diagnostics } = await fixture(t);
+  assert.equal((await run("baseline", "init")).code, 0);
+  await put(baselinePath, '{"findingsBaseline":1}\n{"path":"src/big.ts","rule":"oxlint/eslint/max-lines","count":1,"max":600,"expires":"2027-01-01"}\n');
+  assert.equal((await diagnostics()).outcome, "invalid-input");
+});
+
+test("baseline requires --config and its rules are explained", async () => {
+  const run = (...args) => promisify(execFile)(process.execPath, [cli, ...args]).then((r) => ({ code: 0, ...r }), (e) => ({ code: e.code, stdout: e.stdout, stderr: e.stderr }));
+  assert.equal((await run("baseline", "check")).code, 2);
+  assert.match((await run("baseline", "check")).stderr, /--config/u);
+  assert.match((await run("explain", "quality.findings-baseline.stale-entry")).stdout, /baseline prune/u);
+});
+
+test("a measured rule without a value in its message is a configuration error, not an unexpected failure", async (t) => {
+  const { put, run } = await fixture(t);
+  await put("findings.yaml", { schemaVersion: 1, baselinePath, oxlint: { configPath: "lint.json", roots: ["src"], measuredRules: ["typescript/method-signature-style"] } });
+  const result = await run("baseline", "init");
+  assert.notEqual(result.code, 0);
+  assert.match(JSON.stringify(result.output), /FINDINGS_BASELINE_CONFIG_INVALID/u);
+  assert.match(JSON.stringify(result.output), /no parenthesized value/u);
+});
+
+const ignoredFiles = async (put) => {
+  await put("lint.json", { ignorePatterns: ["dist/**"], rules: { "max-lines": ["error", { max: 3 }] } });
+  // More than 8000 characters of paths: the ignored files fill whole Oxlint batches.
+  for (let index = 0; index < 120; index += 1) {
+    await put(`dist/${"generated-file-with-a-long-name-".repeat(2)}${String(index).padStart(3, "0")}.ts`, lines(6));
+  }
+};
+
+test("batches that hold only ignored files do not fail the producer", async (t) => {
+  const { put, run, baseline } = await fixture(t);
+  await ignoredFiles(put);
+  await put("findings.yaml", { schemaVersion: 1, baselinePath, oxlint: { configPath: "lint.json", roots: ["src", "dist"], measuredRules: ["eslint/max-lines"] } });
+  const created = await run("baseline", "init");
+  assert.equal(created.code, 0, JSON.stringify(created));
+  assert.equal(created.output.baseline.entries, 1);
+  assert.doesNotMatch(await baseline(), /dist\//u);
+  assert.equal((await run("baseline", "check")).code, 0);
+});
+
+test("roots that hold only ignored files are an input error", async (t) => {
+  const { put, run } = await fixture(t);
+  await ignoredFiles(put);
+  await put("findings.yaml", { schemaVersion: 1, baselinePath, oxlint: { configPath: "lint.json", roots: ["dist"], measuredRules: ["eslint/max-lines"] } });
+  const result = await run("baseline", "init");
+  assert.notEqual(result.code, 0);
+  assert.match(JSON.stringify(result.output), /Oxlint linted no file/u);
+});
diff --git a/tests/findings-baseline-ratchet.test.mjs b/tests/findings-baseline-ratchet.test.mjs
new file mode 100644
index 000000000..786bcaad4
--- /dev/null
+++ b/tests/findings-baseline-ratchet.test.mjs
@@ -0,0 +1,92 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  checkBudgets, checkFindings, formatBaseline, formatBudgetAnnotations, initBaseline, parseBaseline, pruneBaseline
+} from "../packages/engineering-foundation/dist/ratchet.js";
+
+const namespace = "oxlint";
+const size = { path: "src/big.ts", rule: "oxlint/eslint/max-lines", count: 1, max: 612 };
+const style = { path: "src/a.ts", rule: "oxlint/typescript/method-signature-style", count: 3 };
+const baseline = [size, style];
+const kinds = (violations) => violations.map(({ kind, path, rule }) => `${kind} ${path} ${rule}`);
+
+test("baseline rejects a new, a raised and a stale entry and accepts equal findings", () => {
+  assert.deepEqual(checkFindings({ baseline, observed: baseline, namespace }), []);
+  const added = { path: "src/new.ts", rule: "oxlint/eslint/max-params", count: 1, max: 6 };
+  assert.deepEqual(kinds(checkFindings({ baseline, observed: [...baseline, added], namespace })),
+    ["new src/new.ts oxlint/eslint/max-params"]);
+  assert.deepEqual(kinds(checkFindings({ baseline, observed: [{ ...size, max: 613 }, style], namespace })),
+    ["worse src/big.ts oxlint/eslint/max-lines"]);
+  assert.deepEqual(kinds(checkFindings({ baseline, observed: [size, { ...style, count: 4 }], namespace })),
+    ["worse src/a.ts oxlint/typescript/method-signature-style"]);
+  assert.deepEqual(kinds(checkFindings({ baseline, observed: [size, { ...style, count: 2 }], namespace })),
+    ["stale src/a.ts oxlint/typescript/method-signature-style"]);
+  assert.deepEqual(kinds(checkFindings({ baseline, observed: [size], namespace })),
+    ["stale src/a.ts oxlint/typescript/method-signature-style"]);
+  assert.deepEqual(kinds(checkFindings({ baseline, observed: [{ ...size, max: 500 }, style], namespace })),
+    ["stale src/big.ts oxlint/eslint/max-lines"]);
+});
+
+test("prune only lowers and removes, and a producer verifies only its own namespace", () => {
+  const foreign = { path: "src/a.ts", rule: "fms/visibility", count: 2 };
+  const all = [...baseline, foreign];
+  const observed = [{ ...size, max: 540 }, { path: "src/new.ts", rule: "oxlint/eslint/max-params", count: 1, max: 6 }];
+  assert.deepEqual(checkFindings({ baseline: all, observed: [], namespace }).map(({ kind }) => kind), ["stale", "stale"]);
+  const pruned = pruneBaseline({ baseline: all, observed, namespace });
+  assert.deepEqual(pruned.entries, [foreign, { ...size, max: 540 }]);
+  assert.equal(pruned.lowered, 1);
+  assert.equal(pruned.removed, 1);
+  assert.deepEqual(kinds(pruned.remaining), ["new src/new.ts oxlint/eslint/max-params"]);
+  const worse = pruneBaseline({ baseline, observed: [{ ...size, count: 2, max: 700 }, style], namespace });
+  assert.deepEqual(worse.entries.find(({ path }) => path === size.path), size);
+  assert.deepEqual(kinds(worse.remaining), ["worse src/big.ts oxlint/eslint/max-lines"]);
+  assert.throws(() => checkFindings({ baseline, observed: [foreign], namespace }), /outside the oxlint namespace/u);
+});
+
+test("prune drops a recorded maximum once the finding no longer carries one", () => {
+  const pruned = pruneBaseline({ baseline: [size], observed: [{ path: size.path, rule: size.rule, count: 1 }], namespace });
+  assert.deepEqual(pruned.entries, [{ path: size.path, rule: size.rule, count: 1 }]);
+  assert.equal(pruned.lowered, 1);
+  assert.deepEqual(pruned.remaining, []);
+});
+
+test("init refuses over an existing baseline", () => {
+  assert.deepEqual(initBaseline({ observed: [size, style] }), [style, size]);
+  assert.throws(() => initBaseline({ observed: baseline, existing: formatBaseline(baseline) }), /already exists/u);
+});
+
+test("baseline text is canonical and hand edits that reorder, duplicate or widen it are rejected", () => {
+  const text = formatBaseline(baseline);
+  assert.deepEqual(parseBaseline(text), [style, size]);
+  const lines = text.split("\n");
+  assert.throws(() => parseBaseline([lines[0], lines[2], lines[1], ""].join("\n")), /not canonical/u);
+  assert.throws(() => parseBaseline([lines[0], lines[1], lines[1], ""].join("\n")), /Duplicate|not canonical/u);
+  assert.throws(() => parseBaseline(text.slice(0, -1)), /newline/u);
+  assert.throws(() => parseBaseline(`${lines[0]}\n{"path":"a.ts","rule":"oxlint/x","count":1,"expires":"2027-01-01"}\n`), /unexpected fields/u);
+  assert.throws(() => formatBaseline([{ path: "../a.ts", rule: "oxlint/x", count: 1 }]), /repository-relative/u);
+  assert.throws(() => formatBaseline([{ path: "a.ts", rule: "no-namespace", count: 1 }]), /namespace/u);
+  assert.throws(() => formatBaseline([{ path: "a.ts", rule: "oxlint/x", count: 0 }]), /positive integer/u);
+});
+
+test("budgets only warn, prefer a subject threshold and escape annotations", () => {
+  const warnings = checkBudgets({
+    measurements: [
+      { subject: "src/a", metric: "files", value: 12 },
+      { subject: "src/b", metric: "files", value: 12 },
+      { subject: "src/c", metric: "depth", value: 2 }
+    ],
+    thresholds: [{ metric: "files", max: 10 }, { metric: "files", subject: "src/b", max: 20 }, { metric: "depth", max: 3 }]
+  });
+  assert.deepEqual(warnings, [{ subject: "src/a", metric: "files", value: 12, max: 10 }]);
+  assert.equal(formatBudgetAnnotations([{ subject: "a,b\n%", metric: "m:x", value: 2, max: 1 }]),
+    "::warning title=m%3Ax budget::a,b%0A%25: m:x is 2, budget 1\n");
+});
+
+test("budgets reject a duplicate threshold and non-finite numbers", () => {
+  const measurements = [{ subject: "src/a", metric: "files", value: 12 }];
+  assert.throws(() => checkBudgets({ measurements, thresholds: [{ metric: "files", max: 10 }, { metric: "files", max: 20 }] }), /more than once/u);
+  assert.throws(() => checkBudgets({ measurements, thresholds: [{ metric: "files", subject: "src/a", max: 1 }, { metric: "files", subject: "src/a", max: 2 }] }), /more than once/u);
+  assert.throws(() => checkBudgets({ measurements, thresholds: [{ metric: "files", max: Number.NaN }] }), /finite/u);
+  assert.throws(() => checkBudgets({ measurements: [{ ...measurements[0], value: Number.POSITIVE_INFINITY }], thresholds: [] }), /finite/u);
+  assert.deepEqual(checkBudgets({ measurements, thresholds: [{ metric: "files", max: 10 }, { metric: "files", subject: "src/a", max: 20 }] }), []);
+});

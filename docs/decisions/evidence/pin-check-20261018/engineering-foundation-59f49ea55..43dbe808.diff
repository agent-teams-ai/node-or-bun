+    files: [...base.files, ...(change.files ?? [])],
+    imports: [...base.imports.filter((record) => !(change.drop?.(record) ?? false)), ...(change.imports ?? [])],
+  };
+  return { id, source, description, input, expect, ok: expect.every((code) => warnings.has(code)) };
+};

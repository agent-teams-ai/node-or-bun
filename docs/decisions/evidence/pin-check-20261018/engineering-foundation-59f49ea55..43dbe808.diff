+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://schemas.agent-teams.ai/engineering-foundation/quality-findings-baseline/v1",
+  "title": "Findings baseline capability configuration",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "baselinePath", "oxlint"],
+  "properties": {
+    "schemaVersion": { "const": 1 },
+    "baselinePath": { "$ref": "#/$defs/repositoryPath" },
+    "oxlint": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["configPath", "roots"],
+      "properties": {
+        "configPath": { "$ref": "#/$defs/repositoryPath" },
+        "roots": {
+          "type": "array",
+          "minItems": 1,
+          "maxItems": 100,
+          "uniqueItems": true,
+          "items": { "$ref": "#/$defs/repositoryPath" }
+        },
+        "measuredRules": {
+          "type": "array",
+          "maxItems": 100,
+          "uniqueItems": true,
+          "items": { "type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[a-z][a-z-]*/[a-z][a-z0-9-]*$" }
+        }
+      }
+    }
+  },
+  "$defs": {
+    "repositoryPath": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 300,
+      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?{}[\\]]).+$"
+    }
+  }
+}

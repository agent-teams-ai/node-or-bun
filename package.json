{
  "name": "node-or-bun",
  "version": "0.2.2",
  "description": "Runtime-agnostic process execution",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/node-or-bun.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./bun": {
      "types": "./dist/adapters/bun.d.ts",
      "import": "./dist/adapters/bun.js"
    },
    "./testing": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "stack-toolchain compile --project tsconfig.build.json",
    "typecheck": "stack-toolchain typecheck",
    "test": "npm run build && npm run build:tests && npm run test:node && npm run test:bun",
    "build:tests": "stack-toolchain compile --project tsconfig.test-build.json",
    "test:node": "node --test dist-tests/tests/conformance.node.test.js dist-tests/tests/native-lifecycle.node.test.js",
    "test:bun": "node scripts/run-bun-tests.ts",
    "test:node-under-bun": "node scripts/run-node-under-bun.ts",
    "pack": "node scripts/pack.ts",
    "qualify": "node scripts/qualify-installed-consumer.ts",
    "verify-toolchain": "node scripts/verify-toolchain.ts",
    "verify-node24": "node scripts/verify-node-compat.ts",
    "check": "npm run verify-toolchain && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:node-under-bun && npm run pack && npm run qualify",
    "lint": "stack-toolchain lint",
    "format:check": "stack-toolchain format:check"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "stack-toolchain": "0.1.0"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": "^24.18.0 || ^26.0.0"
  }
}
